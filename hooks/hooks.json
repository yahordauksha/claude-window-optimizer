{
  "description": "Claude Window Optimizer — prompt logging (UserPromptSubmit) and tune-up reminder (SessionStart)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_prompt.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
